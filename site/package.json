{
  "name": "noahhyden-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "noahhyden.com - authored in pimas, prerendered to static HTML.",
  "scripts": {
    "prebuild": "node scripts/check-comments.mjs && node scripts/check-rules.mjs",
    "build": "node build.mjs",
    "postbuild": "rm -rf ../islands && cp -R ../dist/. ../",
    "serve": "node --watch-path=src build.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:rules": "node scripts/check-rules.mjs"
  },
  "dependencies": {
    "pimas-ui": "0.1.2"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/spectral": "^5.2.8",
    "esbuild": "^0.24.2"
  }
}
